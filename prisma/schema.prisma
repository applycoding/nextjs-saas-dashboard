// Local development and tests use SQLite.
// Production Postgres lives in prisma/schema.postgres.prisma.
// Role is a string in both schemas so the generated client stays the same.
// Allowed values are enforced in src/lib/rbac.ts: owner, admin, viewer.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String       @id @default(cuid())
  name          String?
  email         String?      @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  accounts      Account[]
  sessions      Session[]
  memberships   Membership[]
  createdAt     DateTime     @default(now())
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

model Organization {
  id          String       @id @default(cuid())
  name        String
  slug        String       @unique
  memberships Membership[]
  projects    Project[]
  createdAt   DateTime     @default(now())
}

model Membership {
  id             String       @id @default(cuid())
  role           String
  userId         String
  organizationId String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@unique([userId, organizationId])
}

model Project {
  id             String       @id @default(cuid())
  name           String
  slug           String
  description    String       @default("")
  seeded         Boolean      @default(false)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  events         Event[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, slug])
}

model Event {
  id         String   @id @default(cuid())
  name       String
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  occurredAt DateTime
  count      Int      @default(1)
  // "sample" for seeded demo rows. "recorded" for rows created in the app.
  source     String   @default("recorded")
  createdAt  DateTime @default(now())

  @@index([projectId, occurredAt])
}
